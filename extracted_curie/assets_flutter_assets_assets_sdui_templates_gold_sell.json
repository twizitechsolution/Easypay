{
  "$schema": "https://curie.money/schemas/sdui/v3.json",
  "schemaVersion": "3.0.0",
  "minAppVersion": "3.2.0",
  "screen": {
    "id": "gold_sell",
    "title": "Sell Gold",
    "analytics": { "name": "gold_sell_screen", "class": "GoldSellScreen" },
    "theme": { "backgroundColor": "#FFF7DF", "statusBarStyle": "dark" }
  },
  "config": {
    "cache": { "ttl": 0, "staleWhileRevalidate": false },
    "unknownWidgetBehavior": "hide",
    "rateLock": {
      "lockDurationSeconds": 420,
      "fetchedAt": "{{rateFetchedAt}}",
      "onExpiry": { "type": "NATIVE_CALL", "method": "onRateLockExpired" }
    }
  },
  "body": [
    {
      "id": "header",
      "type": "CONTAINER",
      "padding": { "left": 16, "top": 14, "bottom": 12 },
      "children": [
        {
          "type": "ROW",
          "gap": "sm",
          "crossAxisAlignment": "center",
          "children": [
            { "type": "ICON_BUTTON", "icon": "arrow_back", "size": 24, "action": { "type": "BACK" } },
            { "type": "TEXT", "text": "Selling gold", "style": { "fontSize": 22, "fontWeight": "semibold", "color": "#252529", "lineHeight": 1.27 } }
          ]
        }
      ]
    },

    {
      "id": "holdings_card",
      "type": "CONTAINER",
      "margin": { "horizontal": 24 },
      "padding": { "horizontal": 16, "vertical": 12 },
      "background": { "gradient": ["#FFEFA1", "#FFF6CA"], "direction": "horizontal" },
      "borderColor": "#CA7719",
      "borderRadius": 8,
      "children": [
        {
          "type": "COLUMN",
          "gap": "none",
          "crossAxisAlignment": "start",
          "children": [
            { "type": "TEXT", "text": "You own", "style": { "fontSize": 12, "fontWeight": "semibold", "color": "#252529", "letterSpacing": 0.1 } },
            {
              "type": "ROW",
              "gap": 3,
              "crossAxisAlignment": "center",
              "mainAxisSize": "min",
              "children": [
                { "type": "TEXT", "text": "{{holdingsGrams}} of gold", "style": { "fontSize": 14, "fontWeight": "semibold", "color": "#CA7719", "letterSpacing": 0.1 } },
                { "type": "TEXT", "text": "\u2022", "style": { "fontSize": 14, "fontWeight": "semibold", "color": "#CA7719" } },
                { "type": "TEXT", "text": "worth{{holdingsValue}}", "style": { "fontSize": 14, "fontWeight": "semibold", "color": "#CA7719", "letterSpacing": 0.1 } }
              ]
            }
          ]
        }
      ]
    },

    {
      "id": "sell_section",
      "type": "CONTAINER",
      "margin": { "horizontal": 24, "top": 20 },
      "children": [
        {
          "type": "COLUMN",
          "gap": "sm",
          "crossAxisAlignment": "start",
          "children": [
            { "type": "TEXT", "text": "Amount to sell", "style": { "fontSize": 12, "color": "#7D7D85", "letterSpacing": 0.2 } },
            {
              "id": "sell_card",
              "type": "CONTAINER",
              "background": "#FFFFFF",
              "borderColor": "#C4C1F8",
              "borderRadius": 12,
              "children": [
                {
                  "type": "CONTAINER",
                  "padding": { "horizontal": 16, "top": 12, "bottom": 12 },
                  "children": [
                    {
                      "type": "ROW",
                      "mainAxisAlignment": "spaceBetween",
                      "crossAxisAlignment": "center",
                      "children": [
                        { "type": "TEXT", "text": "{{state.sellAmount}}", "style": { "fontSize": 28, "fontWeight": "semibold", "color": "#252529" } },
                        {
                          "type": "ROW",
                          "gap": 5,
                          "crossAxisAlignment": "center",
                          "mainAxisSize": "min",
                          "children": [
                            { "type": "ICON", "name": "monetization_on", "size": 16, "color": "#252529" },
                            { "type": "TEXT", "text": "Grams", "style": { "fontSize": 16, "fontWeight": "semibold", "color": "#252529", "letterSpacing": 0.15 } },
                            { "type": "ICON", "name": "keyboard_arrow_down", "size": 8, "color": "#252529" }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "CONTAINER",
                  "background": "#F8F7FE",
                  "borderRadius": { "bottomLeft": 11, "bottomRight": 11 },
                  "padding": { "horizontal": 16, "vertical": 8 },
                  "children": [
                    {
                      "type": "ROW",
                      "gap": "md",
                      "children": [
                        { "type": "BUTTON", "label": "10%", "variant": "CHIP", "size": "small", "selected": true, "action": { "type": "NATIVE_CALL", "method": "onPresetSelected", "params": { "percent": 10 } } },
                        { "type": "BUTTON", "label": "25%", "variant": "CHIP", "size": "small", "action": { "type": "NATIVE_CALL", "method": "onPresetSelected", "params": { "percent": 25 } } },
                        { "type": "BUTTON", "label": "50%", "variant": "CHIP", "size": "small", "action": { "type": "NATIVE_CALL", "method": "onPresetSelected", "params": { "percent": 50 } } },
                        { "type": "BUTTON", "label": "Sell all", "variant": "CHIP", "size": "small", "action": { "type": "NATIVE_CALL", "method": "onPresetSelected", "params": { "percent": 100 } } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "id": "receive_section",
      "type": "CONTAINER",
      "margin": { "horizontal": 24, "top": 20 },
      "children": [
        {
          "type": "COLUMN",
          "gap": "sm",
          "crossAxisAlignment": "start",
          "children": [
            { "type": "TEXT", "text": "You receive", "style": { "fontSize": 12, "color": "#7D7D85", "letterSpacing": 0.2 } },
            {
              "id": "receive_card",
              "type": "CONTAINER",
              "background": "#FFFDF1",
              "borderColor": "#F4E5CC",
              "borderRadius": 12,
              "children": [
                {
                  "type": "CONTAINER",
                  "padding": { "horizontal": 16, "top": 12, "bottom": 8 },
                  "children": [
                    {
                      "type": "ROW",
                      "gap": 2,
                      "crossAxisAlignment": "baseline",
                      "mainAxisSize": "min",
                      "children": [
                        { "type": "TEXT", "text": "\u20b9", "style": { "fontSize": 18, "color": "#4A4A52" } },
                        { "type": "TEXT", "text": "{{receiveAmount}}", "style": { "fontSize": 28, "fontWeight": "semibold", "color": "#4A4A52" } }
                      ]
                    }
                  ]
                },
                {
                  "type": "CONTAINER",
                  "background": "#FFF6CA",
                  "borderRadius": { "bottomLeft": 11, "bottomRight": 11 },
                  "padding": { "horizontal": 15, "vertical": 4 },
                  "children": [
                    {
                      "type": "ROW",
                      "mainAxisAlignment": "spaceBetween",
                      "crossAxisAlignment": "center",
                      "children": [
                        {
                          "type": "ROW",
                          "gap": "xs",
                          "crossAxisAlignment": "center",
                          "mainAxisSize": "min",
                          "children": [
                            { "type": "ICON", "name": "lock_clock", "size": 11, "color": "#B57000" },
                            { "type": "TEXT", "text": "Selling @ \u20b9{{unitRate}}/g", "style": { "fontSize": 11, "fontWeight": "medium", "color": "#B57000", "letterSpacing": 0.2 } }
                          ]
                        },
                        {
                          "type": "COUNTDOWN",
                          "startedAt": "{{rateFetchedAt}}",
                          "validUntil": "{{rateValidUntil}}",
                          "durationSeconds": 420,
                          "format": "mm:ss",
                          "prefix": "UPDATES IN ",
                          "style": { "fontSize": 10, "fontWeight": "semibold", "color": "#B57000", "letterSpacing": 0.5 },
                          "onExpired": { "type": "NATIVE_CALL", "method": "onRateLockExpired" }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "type": "CONTAINER",
      "margin": { "horizontal": 24, "top": 12 },
      "children": [
        {
          "type": "ROW",
          "gap": 3,
          "crossAxisAlignment": "center",
          "mainAxisSize": "min",
          "children": [
            { "type": "TEXT", "text": "Money will reach your bank", "style": { "fontSize": 12, "color": "#7D7D85", "letterSpacing": 0.2 } },
            { "type": "TEXT", "text": "by {{deliveryTime}}.", "style": { "fontSize": 12, "fontWeight": "semibold", "color": "#000000", "letterSpacing": 0.1 } }
          ]
        }
      ]
    },

    { "type": "SPACER", "flex": 1 },

    {
      "id": "sell_cta",
      "type": "CONTAINER",
      "padding": { "horizontal": 24, "bottom": 16 },
      "children": [
        {
          "type": "BUTTON",
          "label": "Continue",
          "variant": "CTA_PRIMARY",
          "fullWidth": true,
          "action": {
            "type": "NATIVE_CALL",
            "method": "executeSell",
            "params": { "amount": "{{state.sellAmount}}", "unit": "{{state.sellUnit}}" }
          }
        }
      ]
    }
  ]
}
