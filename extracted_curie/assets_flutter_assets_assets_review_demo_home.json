    "title": "Curie bytes",
    "items": [
     {
      "id": "1",
      "header": "UPI via Curie",
      "title": "How does UPI using mutual fund work?",
      "thumbnailUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/how_thumbnail.webp",
      "viewed": false,
      "carousels": [
       {
        "text": "Let's say you are paying ₹10 to a vendor",
        "tagText": "Step 1",
        "subText": "We notify our partnered fund house to redeem the required amount.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/how_1.webp",
        "shareUrl": null,
        "displayOrder": 1
       },
       {
        "text": "Mutual fund house sends ₹10 from your mutual fund",
        "tagText": "Step 2",
        "subText": "Your linked savings account receives it instantly.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/how_2.webp",
        "shareUrl": null,
        "displayOrder": 2
       },
       {
        "text": "₹10 is now available in your linked bank for the payment",
        "tagText": "Step 3",
        "subText": "Enter your bank UPI PIN and the payment is complete.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/how_3.webp",
        "shareUrl": null,
        "displayOrder": 3
       }
      ]
     },
     {
      "id": "2",
      "header": "Any risks?",
      "title": "What if the market crashes",
      "thumbnailUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/crash_thumbnail.webp",
      "viewed": false,
      "carousels": [
       {
        "text": "Curie keeps your money in debt mutual funds",
        "tagText": "Market crashed?",
        "subText": "Equity market does not impact debt funds.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/crash_1.webp",
        "shareUrl": null,
        "displayOrder": 1
       },
       {
        "text": "Debt funds are stable and very less risky",
        "tagText": "How?",
        "subText": "They invest in government securities, commercial papers, and certificates of deposit. All of these are considered highly secure.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/crash_2.webp",
        "shareUrl": null,
        "displayOrder": 2
       },
       {
        "text": "Curie keeps the money in Liquid funds of ICICI Prudential and Bajaj Finserv",
        "tagText": "Gains?",
        "subText": "Last year the fund grew by 7%.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/crash_3.webp",
        "shareUrl": null,
        "displayOrder": 3
       }
      ]
     },
     {
      "id": "3",
      "header": "Growth in Curie",
      "title": "How does Curie grow my money?",
      "thumbnailUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/grow_thumbnail.webp",
      "viewed": false,
      "carousels": [
       {
        "text": "Curie grows your money in Liquid funds of our partner fund houses",
        "tagText": "Do I own it?",
        "subText": "Yes, they are bought in your mutual fund account linked to your PAN.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/grow_1.webp",
        "shareUrl": null,
        "displayOrder": 1
       },
       {
        "text": "The Liquid fund grew last year at 7%",
        "tagText": "Earn daily",
        "subText": "Money grows daily in Liquid funds.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/grow_2.webp",
        "shareUrl": null,
        "displayOrder": 2
       },
       {
        "text": "Grow your money while you use it via UPI",
        "tagText": "Instant UPI",
        "subText": "Pay anyone, anytime with Curie UPI.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/grow_3.webp",
        "shareUrl": null,
        "displayOrder": 3
       }
      ]
     },
     {
      "id": "4",
      "header": "Spending limit",
      "title": "What and why of daily spending limit?",
      "thumbnailUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/limit_thumbnail.webp",
      "viewed": false,
      "carousels": [
       {
        "text": "You can spend up to 90% of your Liquid fund instantly",
        "tagText": "Instant redemption",
        "subText": "This is the instant redemption limit. We're partnering with more fund houses to raise it.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/limit_1.webp",
        "shareUrl": null,
        "displayOrder": 1
       },
       {
        "text": "₹50,000 is the daily limit per fund",
        "tagText": "The guideline",
        "subText": "This is the instant redemption limit. We're partnering with more fund houses to raise it.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/limit_2.webp",
        "shareUrl": null,
        "displayOrder": 2
       },
       {
        "text": "The rest gets credited in 1 working day",
        "tagText": "Beyond the limit",
        "subText": "We're adding more fund partners so more of your money stays instantly accessible.",
        "svgUrl": "https://curie-money-static-assets.s3.ap-south-1.amazonaws.com/carousels/limit_3.webp",
        "shareUrl": null,
        "displayOrder": 3
       }
      ]
