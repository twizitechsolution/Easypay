{
  "$schema": "https://curie.money/schemas/sdui/v3.json",
  "schemaVersion": "3.0.0",
  "minAppVersion": "3.2.0",
  "screen": {
    "id": "gold_sell_success",
    "title": "Sell Success",
    "analytics": { "name": "gold_sell_success", "class": "GoldSellSuccessScreen" },
    "theme": {
      "backgroundColor": "#FFF7DF",
      "statusBarStyle": "light"
    }
  },
  "config": {
    "cache": { "ttl": 0, "staleWhileRevalidate": false },
    "unknownWidgetBehavior": "hide"
  },

  "body": [
    {
      "id": "success_header",
      "type": "GRADIENT_CONTAINER",
      "gradient": {
        "colors": ["#00863E", "#00C45A"],
        "begin": "topCenter",
        "end": "bottomCenter"
      },
      "height": 322,
      "borderRadius": { "bottomLeft": 16, "bottomRight": 16 },
      "padding": { "left": 24, "top": 54, "right": 24 },
      "decorations": [
        {
          "type": "image",
          "source": "asset://gold_bars.png",
          "position": { "right": 0, "top": 100 },
          "width": 168,
          "height": 110
        }
      ],
      "children": [
        {
          "type": "TEXT",
          "text": "Sell order placed for",
          "style": "title.small.inverse"
        },
        {
          "type": "ROW",
          "gap": "xs",
          "crossAxisAlignment": "baseline",
          "children": [
            {
              "type": "TEXT",
              "text": "{{sellGrams}}",
              "style": { "fontSize": 32, "fontWeight": "semibold", "color": "#FFFFFF" }
            },
            {
              "type": "TEXT",
              "text": "grams",
              "style": { "fontSize": 16, "fontWeight": "semibold", "color": "#EFEFF0" }
            }
          ]
        },
        {
          "type": "BADGE",
          "text": "{{timestamp}}",
          "variant": "dark",
          "size": "small",
          "background": "#00662F",
          "textColor": "#FFFFFF"
        },
        {
          "type": "IMAGE",
          "source": "asset://checkmark_circle.png",
          "width": 82,
          "height": 82
        }
      ]
    },

    {
      "id": "withdrawal_card",
      "type": "CARD",
      "margin": { "horizontal": 24, "top": -106 },
      "background": "surface.default",
      "borderColor": "#C4C1F8",
      "borderWidth": 1,
      "borderRadius": 16,
      "padding": { "horizontal": 16, "top": 12, "bottom": 16 },
      "gap": "sm",
      "children": [
        {
          "type": "ROW",
          "gap": "sm",
          "crossAxisAlignment": "center",
          "children": [
            {
              "type": "TEXT",
              "text": "WITHDRAWAL DETAILS",
              "style": "label.small.primary.bold"
            },
            {
              "type": "DIVIDER",
              "direction": "horizontal",
              "flex": 1,
              "lineStyle": "dashed"
            }
          ]
        },

        {
          "id": "product_card",
          "type": "CARD",
          "background": "surface.default",
          "borderColor": "#FFBB1B",
          "borderWidth": 1,
          "borderRadius": 12,
          "padding": "none",
          "gap": "sm",
          "children": [
            {
              "type": "CONTAINER",
              "background": "#FFF5D8",
              "borderRadius": { "topLeft": 11, "topRight": 11 },
              "padding": { "horizontal": 15, "vertical": 7 },
              "children": [
                {
                  "type": "ROW",
                  "gap": "sm",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "CONTAINER",
                      "background": "surface.default",
                      "borderColor": "#9B6E06",
                      "borderWidth": 1,
                      "borderRadius": 6,
                      "width": 32,
                      "height": 32
                    },
                    {
                      "type": "COLUMN",
                      "gap": "none",
                      "crossAxisAlignment": "start",
                      "children": [
                        { "type": "TEXT", "text": "24-Karat Gold", "style": "body.medium.primary" },
                        {
                          "type": "ROW",
                          "gap": "xs",
                          "crossAxisAlignment": "center",
                          "children": [
                            { "type": "TEXT", "text": "Securely stored with", "style": "body.small.secondary" },
                            { "type": "IMAGE", "source": "asset://safegold_logo.png", "width": 11, "height": 11 },
                            { "type": "TEXT", "text": "SafeGold", "style": "body.small.secondary" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "ROW",
              "mainAxisAlignment": "spaceBetween",
              "padding": { "horizontal": 15 },
              "children": [
                { "type": "TEXT", "text": "Gold sold in grams", "style": "body.small.secondary" },
                { "type": "TEXT", "text": "{{sellGrams}}g", "style": "title.small.primary" }
              ]
            },
            {
              "type": "ROW",
              "mainAxisAlignment": "spaceBetween",
              "padding": { "horizontal": 15, "bottom": 12 },
              "children": [
                { "type": "TEXT", "text": "Sell price", "style": "body.small.secondary" },
                {
                  "type": "TEXT",
                  "text": "\u20b9{{unitRate}}/g",
                  "style": "body.small.secondary"
                }
              ]
            }
          ]
        },

        {
          "type": "BANNER",
          "icon": "schedule",
          "iconColor": "#CA7719",
          "background": "#F8F7FE",
          "borderColor": "#E1E0FB",
          "borderRadius": 8,
          "padding": { "horizontal": 12, "vertical": 12 },
          "children": [
            {
              "type": "COLUMN",
              "gap": "xs",
              "children": [
                { "type": "TEXT", "text": "Next working day withdrawal", "style": "title.small.primary" },
                {
                  "type": "RICH_TEXT",
                  "segments": [
                    { "text": "\u20b9{{receiveAmount}} will be withdrawn to your linked bank account ", "style": "body.small.secondary" },
                    { "text": "by {{deliveryTime}}", "style": "title.small.primary" },
                    { "text": ".", "style": "title.small.primary" }
                  ]
                }
              ]
            }
          ]
        },

        {
          "type": "CONTAINER",
          "background": "#F8F7FE",
          "borderColor": "#E1E0FB",
          "borderRadius": 8,
          "padding": "sm",
          "children": [
            {
              "type": "COLUMN",
              "gap": "xs",
              "children": [
                { "type": "TEXT", "text": "Withdrawal bank", "style": "body.small.secondary" },
                { "type": "TEXT", "text": "{{bankName}} xx{{bankLast4}}", "style": "title.small.primary" }
              ]
            }
          ]
        }
      ]
    },

    { "type": "SPACER", "flex": 1 },

    {
      "id": "bottom_cta",
      "type": "CONTAINER",
      "padding": { "horizontal": 24, "bottom": 42 },
      "children": [
        {
          "type": "BUTTON",
          "label": "Go to Home",
          "variant": "CTA_PRIMARY",
          "fullWidth": true,
          "action": { "type": "NAVIGATE", "route": "/home" }
        }
      ]
    }
  ]
}
